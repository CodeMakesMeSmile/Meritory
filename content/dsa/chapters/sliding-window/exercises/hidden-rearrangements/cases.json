{
  "exercise": "hidden-rearrangements",
  "cases": [
    {
      "uuid": "7bde9871-3454-43e3-a6ec-feb03e69bfd4",
      "description": "finds every rearrangement of the word",
      "property": "hiddenRearrangements",
      "input": {
        "text": "dogodgxgod",
        "word": "god"
      },
      "expected": [0, 2, 3, 7]
    },
    {
      "uuid": "f64eb721-0031-4bc0-8654-b550e296117c",
      "description": "rearrangements can overlap",
      "property": "hiddenRearrangements",
      "input": {
        "text": "aaaa",
        "word": "aa"
      },
      "expected": [0, 1, 2]
    },
    {
      "uuid": "3cdfea4b-0606-4fdb-929f-cc4f5652361d",
      "description": "repeated letters must match in number",
      "property": "hiddenRearrangements",
      "input": {
        "text": "aabab",
        "word": "aab"
      },
      "expected": [0, 1]
    },
    {
      "uuid": "078af03b-3e47-4763-9fff-6007563e3432",
      "description": "a one-letter word",
      "property": "hiddenRearrangements",
      "input": {
        "text": "banana",
        "word": "a"
      },
      "expected": [1, 3, 5]
    },
    {
      "uuid": "5328777e-cfc3-43b5-b2d7-2e24f697b82e",
      "description": "the whole text is a rearrangement",
      "property": "hiddenRearrangements",
      "input": {
        "text": "abc",
        "word": "cab"
      },
      "expected": [0]
    },
    {
      "uuid": "a0054afa-29a8-4332-8201-f42e0fef1cfc",
      "description": "no rearrangement in the text",
      "property": "hiddenRearrangements",
      "input": {
        "text": "abcdef",
        "word": "xyz"
      },
      "expected": []
    },
    {
      "uuid": "6ed9dc76-0d41-40fa-8066-fb2042f85eb6",
      "description": "the right letters in the wrong amounts",
      "property": "hiddenRearrangements",
      "input": {
        "text": "abbaab",
        "word": "aaa"
      },
      "expected": []
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "4d20a02d-938b-45e8-8ef9-89e3dd6c0e68",
          "description": "a word longer than the text",
          "property": "hiddenRearrangements",
          "input": {
            "text": "ab",
            "word": "abc"
          },
          "expected": []
        },
        {
          "uuid": "645dd9e1-512b-4b04-8654-94418f4e3649",
          "description": "an empty text",
          "property": "hiddenRearrangements",
          "input": {
            "text": "",
            "word": "a"
          },
          "expected": []
        },
        {
          "uuid": "2579e819-4c30-4fd0-be62-fe339ca56a6e",
          "description": "a match at the very end",
          "property": "hiddenRearrangements",
          "input": {
            "text": "zzzyx",
            "word": "xy"
          },
          "expected": [3]
        }
      ]
    }
  ]
}

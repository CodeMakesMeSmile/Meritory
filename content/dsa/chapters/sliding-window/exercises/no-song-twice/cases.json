      "input": {
        "songs": [2, 5, 5, 2, 1]
      },
      "expected": 3
    },
    {
      "uuid": "b520071b-95b8-4544-b9c9-afa3b912f04b",
      "description": "a song repeated right away",
      "property": "noSongTwice",
      "input": {
        "songs": [1, 1, 2, 3]
      },
      "expected": 3
    },
    {
      "uuid": "2ddf9e96-9204-40e1-833e-4c2e02c37d1d",
      "description": "no song repeats",
      "property": "noSongTwice",
      "input": {
        "songs": [1, 2, 3]
      },
      "expected": 3
    },
    {
      "uuid": "444fb8e4-18f8-4d8a-b2ee-cedeb525a2ee",
      "description": "the same song all day",
      "property": "noSongTwice",
      "input": {
        "songs": [5, 5, 5]
      },
      "expected": 1
    },
    {
      "uuid": "ed14e072-3477-420e-9edd-f5505344e16e",
      "description": "two songs taking turns",
      "property": "noSongTwice",
      "input": {
        "songs": [8, 9, 8, 9, 8]
      },
      "expected": 2
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "4eed307c-0995-4d88-9676-5cbe02b97b86",
          "description": "an empty log",
          "property": "noSongTwice",
          "input": {
            "songs": []
          },
          "expected": 0
        },
        {
          "uuid": "3195a5cc-f3af-465e-a13c-0fe94eb6680c",
          "description": "one song",
          "property": "noSongTwice",
          "input": {
            "songs": [3]
          },
          "expected": 1
        },
        {
          "uuid": "416887bd-48ce-4ba3-802d-e8a8f1f3ca72",

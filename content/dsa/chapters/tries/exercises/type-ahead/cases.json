{
  "exercise": "type-ahead",
  "cases": [
    {
      "uuid": "b5c8d38c-a715-4cae-905a-d38c94573422",
      "description": "suggests after each letter",
      "property": "typeAhead",
      "input": {
        "products": ["hammer", "hinge", "hook", "hose", "hacksaw"],
        "typed": "hos",
        "k": 2
      },
      "expected": [["hacksaw", "hammer"], ["hook", "hose"], ["hose"]]
    },
    {
      "uuid": "6a2aa47c-da0c-4d31-a3b1-5149589989b7",
      "description": "fewer matches than k",
      "property": "typeAhead",
      "input": {
        "products": ["nail", "nut"],
        "typed": "na",
        "k": 3
      },
      "expected": [["nail", "nut"], ["nail"]]
    },
    {
      "uuid": "7ae3e975-00b4-445b-8e12-5522d359564c",
      "description": "nothing matches after a letter",
      "property": "typeAhead",
      "input": {
        "products": ["drill", "drain"],
        "typed": "dry",
        "k": 2
      },
      "expected": [["drain", "drill"], ["drain", "drill"], []]
    },
    {
      "uuid": "6d84d25d-9f1b-4994-9069-c4115ea29ae4",
      "description": "a name before the longer names that start with it",
      "property": "typeAhead",
      "input": {
        "products": ["saw", "sawhorse", "sander", "saws"],
        "typed": "saw",
        "k": 3
      },
      "expected": [
        ["sander", "saw", "sawhorse"],
        ["sander", "saw", "sawhorse"],
        ["saw", "sawhorse", "saws"]
      ]
    },
    {
      "uuid": "72b7cefa-9a80-47d8-bde8-fd56d0ae4d1b",
      "description": "no match from the first letter",
      "property": "typeAhead",
      "input": {
        "products": ["tape", "tile"],
        "typed": "zip",
        "k": 1
      },
      "expected": [[], [], []]
    },
    {
      "uuid": "054f8335-855f-4f7d-aeb1-7b6339475e79",
      "description": "typing past a whole name",
      "property": "typeAhead",
      "input": {
        "products": ["bolt", "bolts"],
        "typed": "boltss",
        "k": 2
      },
      "expected": [
        ["bolt", "bolts"],

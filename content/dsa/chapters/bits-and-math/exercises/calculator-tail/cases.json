            "digits": 3
          },
          "expected": 0
        },
        {
          "uuid": "0efa6fc0-fb3c-41f2-bae8-19d464e6ccd9",
          "description": "a power of ten shows all zeros",
          "property": "lastDigits",
          "input": {
            "base": 10,
            "exponent": 12,
            "digits": 6
          },
          "expected": 0
        },
        {
          "uuid": "329152c5-8901-4b06-a706-5bdb6713e9c6",
          "description": "a base of a billion",
          "property": "lastDigits",
          "input": {
            "base": 1000000000,
            "exponent": 1,
            "digits": 9
          },
          "expected": 0
        },
        {
          "uuid": "38d24f5f-2c83-43d8-8806-ce5ceac849ec",
          "description": "one digit on screen",
          "property": "lastDigits",
          "input": {
            "base": 2,
            "exponent": 1099511627779,
            "digits": 1
          },
          "expected": 8

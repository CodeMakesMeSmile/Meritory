    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "1f98337c-e8e9-400b-98dd-5165f0c9b8a4",
          "description": "anything to the power 0 is 1",
          "property": "lastDigits",
          "input": {
            "base": 12,
            "exponent": 0,
            "digits": 5
          },
          "expected": 1
        },
        {
          "uuid": "358436b8-cbad-4e59-96b8-c52f9c961d9d",
          "description": "0 to the power 0 is 1",
          "property": "lastDigits",
          "input": {
            "base": 0,
            "exponent": 0,
            "digits": 3
          },
          "expected": 1
        },
        {
          "uuid": "2e1456f4-c2b3-4b0c-809e-fc8ea6e42db1",

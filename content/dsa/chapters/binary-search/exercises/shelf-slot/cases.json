      "property": "shelfSlot",
      "input": {
        "ids": [3, 8, 8, 12, 20],
        "newId": 25
      },
      "expected": 5
    },
    {
      "uuid": "e6516fd0-f143-4b1d-b51e-f2ed6e3ab993",

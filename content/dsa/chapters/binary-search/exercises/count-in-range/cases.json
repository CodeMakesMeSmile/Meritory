{
  "exercise": "count-in-range",
  "cases": [
    {
      "uuid": "98c62009-953c-4a6e-afac-fa260df68dee",
      "description": "counts the readings in range",
      "property": "countBetween",
      "input": {
        "readings": [3, 7, 7, 10, 14, 14, 21],
        "low": 7,
        "high": 14
      },
      "expected": 5
    },
    {
      "uuid": "8665a603-c1c3-46eb-8a92-59ace5b615f3",
      "description": "a range with no readings",
      "property": "countBetween",
      "input": {
        "readings": [3, 7, 7, 10],
        "low": 8,
        "high": 9
      },
      "expected": 0
    },
    {
      "uuid": "7f654771-dafd-4506-96a8-186b7d4284c6",
      "description": "a range around every reading",
      "property": "countBetween",
      "input": {
        "readings": [3, 7, 7, 10],
        "low": 0,
        "high": 100
      },
      "expected": 4
    },
    {
      "uuid": "02e1fbf7-ca56-4656-a104-23c00bb21be0",
      "description": "a range of one value",
      "property": "countBetween",
      "input": {
        "readings": [3, 7, 7, 10],
        "low": 7,
        "high": 7
      },
      "expected": 2
    },
    {
      "uuid": "087b083c-f1e0-46a5-a377-184651e4d901",
      "description": "edges that aren't readings",
      "property": "countBetween",
      "input": {
        "readings": [3, 7, 7, 10, 14],
        "low": 4,
        "high": 12
      },
      "expected": 3
    },
    {
      "uuid": "57e0b432-d8c3-4cfa-ba71-0107de95ea09",
      "description": "a range below every reading",
      "property": "countBetween",
      "input": {
        "readings": [5, 6],
        "low": 1,
        "high": 4
      },
      "expected": 0
    },
    {
      "uuid": "fbbca454-b4fb-4fe5-a2ba-84dc5bee7e45",
      "description": "a range above every reading",
      "property": "countBetween",
      "input": {
        "readings": [5, 6],
        "low": 7,
        "high": 9
      },
      "expected": 0
    },
    {
      "uuid": "43ba38f1-f808-498c-9c4f-0fe50e6c25d0",
      "description": "low is more than high",
      "property": "countBetween",
      "input": {
        "readings": [1, 2, 3],
        "low": 3,
        "high": 1
      },
      "expected": 0
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "19d9a853-18c9-47ed-a132-8f33403481cc",
          "description": "no readings",
          "property": "countBetween",
          "input": {
            "readings": [],
            "low": 0,
            "high": 10
          },
          "expected": 0
        },
        {
          "uuid": "7e81e939-d5c0-407b-a706-b532cd0ebb82",
          "description": "every reading the same",
          "property": "countBetween",
          "input": {
            "readings": [4, 4, 4, 4],
            "low": 4,
            "high": 4
          },
          "expected": 4
        },
        {
          "uuid": "510f241c-f814-4fc7-901c-77a34ee454d5",
          "description": "handles the largest readings",
          "property": "countBetween",
          "input": {
            "readings": [0, 1000000, 1000000],
            "low": 1000000,
            "high": 1000000
          },
          "expected": 2
        }
      ]
    }
  ]
}

{
  "exercise": "pack-the-tree",
  "cases": [
    {
      "uuid": "7003eea7-f959-4066-b37d-f976f58af2a3",
      "description": "writes each scene before its choices",
      "property": "packTree",
      "input": {
        "story": [1, 2, 3, null, null, 4, 5]
      },
      "expected": "1,2,#,#,3,4,#,#,5,#,#"
    },
    {
      "uuid": "96ecce78-53f4-45b2-b343-4fa70d7d4673",
      "description": "a full tree of three levels",
      "property": "packTree",
      "input": {
        "story": [4, 2, 6, 1, 3, 5, 7]
      },
      "expected": "4,2,1,#,#,3,#,#,6,5,#,#,7,#,#"
    },
    {
      "uuid": "98ea49b3-d13b-425e-a717-66fec236d2eb",
      "description": "every scene leads only to a first choice",
      "property": "packTree",
      "input": {
        "story": [3, 2, null, 1]
      },
      "expected": "3,2,1,#,#,#,#"
    },
    {
      "uuid": "0e8d38e1-206d-45df-b76c-826dfe438a0d",
      "description": "every scene leads only to a second choice",
      "property": "packTree",
      "input": {
        "story": [3, null, 2, null, 1]
      },
      "expected": "3,#,2,#,1,#,#"
    },
    {
      "uuid": "ca636678-5e3f-4adb-8ebd-560da7a6d4b1",
      "description": "some scenes have only a first choice",
      "property": "packTree",
      "input": {
        "story": [10, 5, null, 3, 8, null, null, 7]
      },
      "expected": "10,5,3,#,#,8,7,#,#,#,#"
    },
    {
      "uuid": "80732edf-7e98-4f2b-be51-3e4b22f4dcb4",
      "description": "negative scene numbers",
      "property": "packTree",
      "input": {
        "story": [-4, -10, 6]
      },
      "expected": "-4,-10,#,#,6,#,#"
    },
    {
      "uuid": "2128c39b-97af-454e-b3d4-9a40fc771749",
      "description": "repeated scene numbers",
      "property": "packTree",
      "input": {
        "story": [2, 2, 2]
      },
      "expected": "2,2,#,#,2,#,#"
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "a17c7920-b121-4aae-8827-701f65bcf1c1",
          "description": "an empty story",
          "property": "packTree",
          "input": {
            "story": []
          },
          "expected": "#"
        },
        {
          "uuid": "4c7ee952-6f20-4313-a435-015ca9f998a1",
          "description": "one scene",
          "property": "packTree",
          "input": {
            "story": [7]
          },
          "expected": "7,#,#"
        }
      ]
    }
  ]
}

      },
      "expected": [8, 8, 8]
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "755e632b-b880-4c74-9026-eb2921da2e5b",
          "description": "no lanterns",
          "property": "seenFromEast",
          "input": {
            "lanterns": []
          },
          "expected": []
        },
        {
          "uuid": "96709533-c1b1-4acd-b815-020d05f5ae5d",

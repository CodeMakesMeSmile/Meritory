      },
      "expected": [3, 2, 1]
    },
    {
      "uuid": "4b34a324-012e-4916-8e49-a18f7c2442bb",
      "description": "every lantern hangs to the right",
      "property": "seenFromEast",
      "input": {
        "lanterns": [3, null, 2, null, 1]
      },
      "expected": [3, 2, 1]
    },
    {

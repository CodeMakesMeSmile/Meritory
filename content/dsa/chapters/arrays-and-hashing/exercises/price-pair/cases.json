{
  "exercise": "price-pair",
  "cases": [
    {
      "uuid": "4a14a57f-a9fc-4ed3-9625-7c2aaaabff90",
      "description": "finds the two prices that fill the card",
      "property": "pricePair",
      "input": {
        "prices": [5, 3, 7, 3],
        "target": 6
      },
      "expected": [1, 3]
    },
    {
      "uuid": "dcc02639-3a5b-43c3-9272-e8a6280d1420",
      "description": "the pair can sit at both ends",
      "property": "pricePair",
      "input": {
        "prices": [4, 8, 1, 6],
        "target": 10
      },
      "expected": [0, 3]
    },
    {
      "uuid": "8b68a1c7-cfaa-45db-925e-6948fe6c2f28",
      "description": "returns the pair that finishes first",
      "property": "pricePair",
      "input": {
        "prices": [3, 4, 2, 3],
        "target": 6
      },
      "expected": [1, 2]
    },
    {
      "uuid": "0f93280b-79fa-40e4-bf73-a68db76e6d1d",
      "description": "uses the earliest matching price for the first position",
      "property": "pricePair",
      "input": {
        "prices": [2, 2, 4],
        "target": 6
      },
      "expected": [0, 2]
    },
    {
      "uuid": "10fc71dd-4336-440f-92dc-556d9de4a06f",
      "description": "two equal prices can make a pair",
      "property": "pricePair",
      "input": {
        "prices": [3, 3],
        "target": 6
      },
      "expected": [0, 1]
    },
    {
      "uuid": "8c244e13-973d-47ed-ac21-c4bc01484959",
      "description": "a price can't pair with itself",
      "property": "pricePair",
      "input": {
        "prices": [3, 1],
        "target": 6
      },
      "expected": []
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "1421a0e1-beb7-478f-b430-858e009e8003",
          "description": "an empty list has no pair",
          "property": "pricePair",
          "input": {
            "prices": [],
            "target": 6
          },
          "expected": []
        },
        {
          "uuid": "39e069bc-aa42-47a0-86e4-94069056eae2",
          "description": "one price has no pair",
          "property": "pricePair",
          "input": {
            "prices": [6],
            "target": 6
          },
          "expected": []
        },
        {
          "uuid": "71576695-a686-4035-a383-bbf9d7ebcfb7",
          "description": "negative prices count",
          "property": "pricePair",
          "input": {
            "prices": [-3, 4, -1, 8],
            "target": 7
          },
          "expected": [2, 3]
        },
        {
          "uuid": "c8b7ff03-8713-4609-93be-2aeea6feda27",
          "description": "a target of 0 pairs a price with its negative",
          "property": "pricePair",
          "input": {
            "prices": [-2, 5, 2],
            "target": 0
          },
          "expected": [0, 2]
        },
        {
          "uuid": "4e69e72b-608f-4d2e-83db-204263372eb7",
          "description": "handles the largest and smallest prices",
          "property": "pricePair",
          "input": {
            "prices": [1000000000, -1000000000, 7],
            "target": 0
          },
          "expected": [0, 1]
        }
      ]
    }
  ]
}

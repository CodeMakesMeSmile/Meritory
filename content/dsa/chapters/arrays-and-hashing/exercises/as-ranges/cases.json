{
  "exercise": "as-ranges",
  "cases": [
    {
      "uuid": "0cfe63eb-77aa-426c-a597-1a2a0ae56edc",
      "description": "joins consecutive ids into ranges",
      "property": "asRanges",
      "input": {
        "ids": [5, 1, 2, 9, 3, 5]
      },
      "expected": [[1, 3], [5, 5], [9, 9]]
    },
    {
      "uuid": "1bba5fd1-27b7-4245-a55e-008d5bcdc789",
      "description": "one range covers them all",
      "property": "asRanges",
      "input": {
        "ids": [4, 2, 3]
      },
      "expected": [[2, 4]]
    },
    {
      "uuid": "8f655052-8bf3-41fe-a8bd-075132db31f7",
      "description": "ranges can cross zero",
      "property": "asRanges",
      "input": {
        "ids": [-1, 1, 0, -5]
      },
      "expected": [[-5, -5], [-1, 1]]
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "cc481b54-619c-4857-ae9e-8a83b11cac21",
          "description": "no ids make no ranges",
          "property": "asRanges",
          "input": {
            "ids": []
          },
          "expected": []
        },
        {
          "uuid": "e6e4c1ba-ed3b-4f5d-801d-bce71f9bd71a",
          "description": "one id is a range of one",
          "property": "asRanges",
          "input": {
            "ids": [8]
          },
          "expected": [[8, 8]]
        },
        {
          "uuid": "c9c9beef-9899-4663-826c-fab5533644bf",
          "description": "a repeated id is still one range",
          "property": "asRanges",
          "input": {
            "ids": [3, 3, 3]
          },
          "expected": [[3, 3]]
        }
      ]
    }
  ]
}

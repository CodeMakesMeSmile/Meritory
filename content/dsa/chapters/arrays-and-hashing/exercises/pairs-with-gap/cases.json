{
  "exercise": "pairs-with-gap",
  "cases": [
    {
      "uuid": "ea28ca02-6796-49ba-8f88-e87f1c892de2",
      "description": "counts each pair of positions",
      "property": "pairsWithGap",
      "input": {
        "scores": [1, 5, 3, 5],
        "gap": 2
      },
      "expected": 3
    },
    {
      "uuid": "07944e38-06ef-41f8-ac71-6ccd994cdeca",
      "description": "neighbours in a sequence",
      "property": "pairsWithGap",
      "input": {
        "scores": [1, 2, 3, 4, 5],
        "gap": 1
      },
      "expected": 4
    },
    {
      "uuid": "f2362798-275f-464e-86ae-a2f8cad0dc38",
      "description": "a gap of 0 counts equal scores",
      "property": "pairsWithGap",
      "input": {
        "scores": [7, 7, 7, 2],
        "gap": 0
      },
      "expected": 3
    },
    {
      "uuid": "0d61c0e5-a3d3-4cb1-a49b-0a0d50636825",
      "description": "repeated scores make more pairs",
      "property": "pairsWithGap",
      "input": {
        "scores": [1, 1, 3, 3],
        "gap": 2
      },
      "expected": 4
    },
    {
      "uuid": "cf2dbc53-745b-43e5-8fa8-abd7e2778606",
      "description": "no scores are the gap apart",
      "property": "pairsWithGap",
      "input": {
        "scores": [1, 10, 20],
        "gap": 4
      },
      "expected": 0
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "1707bfb3-14f5-47de-ab85-4fbb0334636a",
          "description": "an empty list has no pairs",
          "property": "pairsWithGap",
          "input": {
            "scores": [],
            "gap": 1
          },
          "expected": 0
        },
        {
          "uuid": "28534ad8-adc7-4d40-adfd-eb2e1544feb0",
          "description": "one score has no pairs",
          "property": "pairsWithGap",
          "input": {
            "scores": [5],
            "gap": 0
          },
          "expected": 0
        },
        {
          "uuid": "918dc6fe-db95-4249-af54-aa57c2dd6b80",
          "description": "negative scores count",
          "property": "pairsWithGap",
          "input": {
            "scores": [-2, 0, 2, -4],
            "gap": 2
          },
          "expected": 3
        },
        {
          "uuid": "a94349b0-83c4-42fc-927a-bfe647df2f65",
          "description": "handles the widest gap",
          "property": "pairsWithGap",
          "input": {
            "scores": [-1000000000, 0, 1000000000],
            "gap": 1000000000
          },
          "expected": 2
        }
      ]
    }
  ]
}

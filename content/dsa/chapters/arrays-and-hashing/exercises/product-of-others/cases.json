{
  "exercise": "product-of-others",
  "cases": [
    {
      "uuid": "a13e355c-d676-4b08-b144-6e0c2335918e",
      "description": "multiplies everything but each number",
      "property": "productOfOthers",
      "input": {
        "nums": [2, 3, 4]
      },
      "expected": [12, 8, 6]
    },
    {
      "uuid": "c21ac7a9-426f-4f9b-8510-f543cc6bac24",
      "description": "a longer list",
      "property": "productOfOthers",
      "input": {
        "nums": [1, 2, 3, 4]
      },
      "expected": [24, 12, 8, 6]
    },
    {
      "uuid": "e6ea9a64-e539-4575-8501-c8fe161e64ee",
      "description": "one zero leaves one product that isn't 0",
      "property": "productOfOthers",
      "input": {
        "nums": [1, 0, 3]
      },
      "expected": [0, 3, 0]
    },
    {
      "uuid": "d69d62b8-4958-4f5c-bd7e-f187ce8e8c38",
      "description": "two zeros make every product 0",
      "property": "productOfOthers",
      "input": {
        "nums": [0, 4, 0]
      },
      "expected": [0, 0, 0]
    },
    {
      "uuid": "4c44ab1e-7f17-449c-8333-153649a2a772",
      "description": "negative numbers flip the sign",
      "property": "productOfOthers",
      "input": {
        "nums": [-1, 2, -3]
      },
      "expected": [-6, 3, -2]
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "984ea6ce-9935-459e-b0cf-fa831dc94936",
          "description": "one number gives 1",
          "property": "productOfOthers",
          "input": {
            "nums": [9]
          },
          "expected": [1]
        },
        {
          "uuid": "f5def69d-cd14-40c2-afb8-6d3a117b363d",
          "description": "two numbers swap",
          "property": "productOfOthers",
          "input": {
            "nums": [5, -2]
          },
          "expected": [-2, 5]
        },
        {
          "uuid": "7c7775d7-9f35-4133-8fae-004fd722b761",
          "description": "a zero with negative numbers gives 0, not -0",
          "property": "productOfOthers",
          "input": {
            "nums": [0, -1, -2]
          },
          "expected": [2, 0, 0]
        }
      ]
    }
  ]
}

{
  "exercise": "top-scores",
  "cases": [
    {
      "uuid": "e7f74407-cedf-4d17-9322-f1a52b273904",
      "description": "lists the top three, highest first",
      "property": "topScores",
      "input": {
        "scores": [55, 80, 62, 91, 70],
        "k": 3
      },
      "expected": [91, 80, 70]
    },
    {
      "uuid": "f173d846-4dc7-495a-807d-587a7579de91",
      "description": "repeated scores each count",
      "property": "topScores",
      "input": {
        "scores": [70, 85, 85, 60],
        "k": 2
      },
      "expected": [85, 85]
    },
    {
      "uuid": "aa8940a3-19e8-41a7-90c4-451e118271a4",
      "description": "k is the number of teams",
      "property": "topScores",
      "input": {
        "scores": [3, 1, 2],
        "k": 3
      },
      "expected": [3, 2, 1]
    },
    {
      "uuid": "173b84d7-0b22-4514-8d34-3f968ddb830b",
      "description": "only the winner",
      "property": "topScores",
      "input": {
        "scores": [12, 40, 33, 7],
        "k": 1
      },
      "expected": [40]
    },
    {
      "uuid": "95c8017c-faed-41ae-bc19-c1458e9afdf0",
      "description": "penalties can make scores negative",
      "property": "topScores",
      "input": {
        "scores": [-5, 0, -2, -9],
        "k": 2
      },
      "expected": [0, -2]
    },
    {
      "uuid": "ba4374f8-9802-4e06-bfa5-006240d4ed6b",
      "description": "scores already from highest to lowest",
      "property": "topScores",
      "input": {
        "scores": [9, 8, 7, 6, 5],
        "k": 3
      },
      "expected": [9, 8, 7]
    },
    {
      "uuid": "5c6831bf-0fb8-4f79-b366-e3e142b882e8",
      "description": "scores from lowest to highest",
      "property": "topScores",
      "input": {
        "scores": [1, 2, 3, 4, 5, 6],
        "k": 4
      },
      "expected": [6, 5, 4, 3]
    },
    {
      "uuid": "b9bb05a3-4ee9-44d0-9e91-00ed9bf97b71",
      "description": "a long night of scores",
      "property": "topScores",
      "input": {
        "scores": [
          185, 189, 65, 183, 200, 183, 135, 197, 14, -29, 51, 85, 153, 186, 182,
          111, -1, 171, 34, 84, 190, 115, 30, -1, 47, 98, -42, 200, 132, 106,
          15, 83, 173, 105, -3, 199, 46, 198, 191, 46
        ],
        "k": 7
      },
      "expected": [200, 200, 199, 198, 197, 191, 190]
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "668f12ea-9084-4548-8faa-8bce964a2d5b",
          "description": "one team",
          "property": "topScores",
          "input": {
            "scores": [12],
            "k": 1
          },
          "expected": [12]
        },
        {
          "uuid": "9449a7e9-6d48-4788-b36a-0d80fc7e9533",
          "description": "every score the same",
          "property": "topScores",
          "input": {
            "scores": [4, 4, 4, 4],
            "k": 3
          },
          "expected": [4, 4, 4]
        }
      ]
    }
  ]
}

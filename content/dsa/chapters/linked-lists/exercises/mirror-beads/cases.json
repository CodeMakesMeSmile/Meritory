      "input": {
        "beads": [5, 4, 3, 3, 4, 5]
      },
      "expected": true
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "24d13a5d-d867-4c87-9967-68b7cd449a19",

      "property": "alternateCourses",
      "input": {
        "courses": [1, 2, 3, 4]
      },
      "expected": [1, 4, 2, 3]
    },
    {
      "uuid": "a2b69e1e-ba75-461c-b85c-1421f4e3a1ee",
      "description": "three courses",
      "property": "alternateCourses",
      "input": {
        "courses": [1, 2, 3]
      },
      "expected": [1, 3, 2]
    },
    {
      "uuid": "e7450f03-bbeb-49ba-ad6a-14128cb1bef5",
      "description": "the order comes from positions, not values",

        "prices": [10, 20, 30, 40],
        "budget": 50
      },
      "expected": 50
    },
    {
      "uuid": "1632f8a0-5e05-46e1-87b6-85865187c1e5",
      "description": "every pair is over budget",
      "property": "giftsUnderBudget",
      "input": {
        "prices": [30, 40, 50],
        "budget": 60
      },
      "expected": -1
    },
    {
      "uuid": "f40024e1-d915-4b9d-b242-960fa9dbb49e",

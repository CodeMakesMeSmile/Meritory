      "property": "giftsUnderBudget",
      "input": {
        "prices": [5, 10, 100, 200],
        "budget": 20
      },
      "expected": 15
    },
    {
      "uuid": "03aa358a-f39a-4684-8035-c25bb4bf90da",
      "description": "a large budget takes the two dearest gifts",
      "property": "giftsUnderBudget",
      "input": {
        "prices": [1, 2, 3, 9, 10],
        "budget": 100
      },
      "expected": 19
    },
    {
      "uuid": "f4cc2f8c-08e7-45f0-9f0f-eb84a1c60fff",
      "description": "the same gift can't be bought twice",
      "property": "giftsUnderBudget",
      "input": {
        "prices": [10, 60],
        "budget": 25
      },
      "expected": -1
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "f9030914-aa8c-4833-8765-56cb59198724",
          "description": "no gifts make no pair",
          "property": "giftsUnderBudget",
          "input": {
            "prices": [],
            "budget": 100
          },
          "expected": -1
        },
        {
          "uuid": "bdd37f91-1424-48e6-a6eb-4e7abd01d9d9",
          "description": "one gift makes no pair",
          "property": "giftsUnderBudget",
          "input": {
            "prices": [5],
            "budget": 100
          },
          "expected": -1
        },
        {
          "uuid": "76e078b0-f583-46bc-8b48-a575fe1b1d8c",
          "description": "handles the largest prices and budget",
          "property": "giftsUnderBudget",
          "input": {
            "prices": [1000000, 1000000],

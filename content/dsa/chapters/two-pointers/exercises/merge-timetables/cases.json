{
  "exercise": "merge-timetables",
  "cases": [
    {
      "uuid": "b0a6d35c-29f7-44de-80a7-e2350f0e1574",
      "description": "merges two timetables in order",
      "property": "mergeTimetables",
      "input": {
        "first": [5, 20, 40],
        "second": [10, 20, 55]
      },
      "expected": [5, 10, 20, 20, 40, 55]
    },
    {
      "uuid": "d7ba1243-486c-4ab9-8e6e-6234e475ddd3",
      "description": "times that take turns",
      "property": "mergeTimetables",
      "input": {
        "first": [1, 3, 5],
        "second": [2, 4, 6]
      },
      "expected": [1, 2, 3, 4, 5, 6]
    },
    {
      "uuid": "4380adec-a136-4c44-bca3-fb1dbfcb3717",
      "description": "every time in one list comes first",
      "property": "mergeTimetables",
      "input": {
        "first": [8, 9],
        "second": [1, 2]
      },
      "expected": [1, 2, 8, 9]
    },
    {
      "uuid": "2b5ce770-2f26-4fbe-b9f4-bf5e12d4b89a",
      "description": "lists of different lengths",
      "property": "mergeTimetables",
      "input": {
        "first": [0],
        "second": [1, 2, 3, 1439]
      },
      "expected": [0, 1, 2, 3, 1439]
    },
    {
      "uuid": "6c530d93-0464-4d51-a8c4-4352ce49cc9a",
      "description": "repeated times within a list stay",
      "property": "mergeTimetables",
      "input": {
        "first": [7, 7],
        "second": [7]
      },
      "expected": [7, 7, 7]
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "28465f3f-dcf3-4ac1-8a50-1eec23c90cd8",
          "description": "the first route has no departures",
          "property": "mergeTimetables",
          "input": {
            "first": [],
            "second": [3, 4]
          },
          "expected": [3, 4]
        },
        {
          "uuid": "6f92d496-548b-481c-b9c4-57ab032abf8d",
          "description": "the second route has no departures",
          "property": "mergeTimetables",
          "input": {
            "first": [3, 4],
            "second": []
          },
          "expected": [3, 4]
        },
        {
          "uuid": "2e718f9a-c4a8-42fc-a727-36f1a90a8d84",
          "description": "neither route has departures",
          "property": "mergeTimetables",
          "input": {
            "first": [],
            "second": []
          },
          "expected": []
        },
        {
          "uuid": "3b52d071-a958-47fe-9c7b-6022031a90f3",
          "description": "the first and last minutes of the day",
          "property": "mergeTimetables",
          "input": {
            "first": [1439],
            "second": [0]
          },
          "expected": [0, 1439]
        }
      ]
    }
  ]
}

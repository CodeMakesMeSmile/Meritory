{
  "exercise": "balanced-triples",
  "cases": [
    {
      "uuid": "58b0076f-7ba9-45a1-8501-533c3eaab82b",
      "description": "finds each set that balances once",
      "property": "balancedTriples",
      "input": {
        "amounts": [3, -1, -2, 1, 0, -1]
      },
      "expected": [[-2, -1, 3], [-1, 0, 1]]
    },
    {
      "uuid": "36e770ac-4c90-4078-9aa1-67bd84223b10",
      "description": "finds several sets",
      "property": "balancedTriples",
      "input": {
        "amounts": [-3, -2, 1, 2, 4, -1, 0]
      },
      "expected": [[-3, -1, 4], [-3, 1, 2], [-2, 0, 2], [-1, 0, 1]]
    },
    {
      "uuid": "79528d31-74b6-4397-a915-0190a77a2834",
      "description": "repeated amounts make one set",
      "property": "balancedTriples",
      "input": {
        "amounts": [-1, -1, 2, 2, -1]
      },
      "expected": [[-1, -1, 2]]
    },
    {
      "uuid": "93ec865d-0775-4dd4-8f6b-78b5f0ed35a5",
      "description": "three zeros balance",
      "property": "balancedTriples",
      "input": {
        "amounts": [0, 0, 0, 0]
      },
      "expected": [[0, 0, 0]]
    },
    {
      "uuid": "c722e9da-8100-4f40-ac02-a13cba7e5117",
      "description": "an amount can't be used twice",
      "property": "balancedTriples",
      "input": {
        "amounts": [-2, 1, 5]
      },
      "expected": []
    },
    {
      "uuid": "a3c39f3a-147b-42da-916b-e1aa073a1ace",
      "description": "nothing balances",
      "property": "balancedTriples",
      "input": {
        "amounts": [1, 2, -4]
      },
      "expected": []
    },
    {
      "description": "edge cases",
      "cases": [
        {
          "uuid": "edf56422-e984-4e51-9d0e-1655b92e6e61",
          "description": "an empty ledger",
          "property": "balancedTriples",
          "input": {
            "amounts": []
          },
          "expected": []
        },
        {
          "uuid": "ca9f1f63-6c81-479c-9872-0c71b26dbaff",
          "description": "two entries are too few",
          "property": "balancedTriples",
          "input": {
            "amounts": [0, 0]
          },
          "expected": []
        },
        {
          "uuid": "95d8d487-496d-4c8b-8258-2865b16a02e3",
          "description": "exactly three entries that balance",
          "property": "balancedTriples",
          "input": {
            "amounts": [-5, 2, 3]
          },
          "expected": [[-5, 2, 3]]
        },
        {
          "uuid": "af0c338c-7f8e-41c5-8abf-3d98afd6649e",
          "description": "handles the largest amounts",
          "property": "balancedTriples",
          "input": {
            "amounts": [100000, -100000, 0, 100000]
          },
          "expected": [[-100000, 0, 100000]]
        }
      ]
    }
  ]
}

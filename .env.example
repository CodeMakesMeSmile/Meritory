# Copy to .env and fill in what you need. Defaults match docker-compose.yml.

# Database
DATABASE_URL=postgres://meritory:meritory@localhost:5432/meritory

# API
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=meritory-local
S3_ACCESS_KEY_ID=meritory
S3_SECRET_ACCESS_KEY=meritory-local-secret

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Meritory <no-reply@meritory.localhost>

# Sign-in
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
AI_PROVIDER=mock
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

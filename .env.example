# Copy to .env and fill in what you need. Defaults match docker-compose.yml.

# Database
DATABASE_URL=postgres://meritory:meritory@localhost:5432/meritory
# Tests read TEST_DATABASE_URL from the shell, not this file. See CONTRIBUTING.md.

# API
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=meritory-local
S3_ACCESS_KEY_ID=meritory
S3_SECRET_ACCESS_KEY=meritory-local-secret

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Meritory <no-reply@meritory.localhost>
SMTP_USER=
SMTP_PASSWORD=

# Sign-in
# At least 32 characters, for example from `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Client IP headers and proxies to trust, comma-separated. Unset trusts X-Forwarded-For.
# AUTH_IP_HEADERS=
# AUTH_TRUSTED_PROXIES=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
AI_PROVIDER=mock
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

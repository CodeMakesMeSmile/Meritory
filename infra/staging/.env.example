# Staging settings. The install script copies this to /opt/meritory/.env,
# readable by root only. Fill in every value there, never in the repo.

# Letters and digits only, since it goes into a URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Seals queued emails, which hold sign-in links: openssl rand -base64 32
MAIL_JOB_KEY=

# The public https address the Tunnel serves, with no path
WEB_ORIGIN=

# The SES SMTP login, see docs/email-sending.md
SMTP_USER=
SMTP_PASSWORD=
